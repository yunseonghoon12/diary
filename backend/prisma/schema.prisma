generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Firebase Auth UID와 1:1 (첫 로그인 시 upsert)
model User {
  id           String       @id @default(cuid())
  firebaseUid  String       @unique
  createdAt    DateTime     @default(now())
  diaryEntries DiaryEntry[]
}

model DiaryEntry {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  content          String?
  /// 추후 스토리지 URL
  imageUrl         String?
  /// 사용자가 고른 일기 날짜 (달력 기준)
  entryDate        DateTime @db.Date
  weather          String?
  wakeTime         String?
  /// 제출 시 합성 PNG (data URL 제외 순수 base64 권장)
  picturePngBase64 String?  @db.Text
  /// OpenAI 등으로 생성한 선생님 톤 피드백
  teacherReply     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, entryDate])
  @@index([userId, createdAt])
}
