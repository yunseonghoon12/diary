PORT=4000
CORS_ORIGIN=http://localhost:3000
# Prisma는 PostgreSQL 전용입니다. MySQL URL(mysql://)은 사용할 수 없습니다.
# DATABASE_URL 은 backend/.env 또는 상위 diary-app/.env 한 곳.
#
# Docker(Docker Desktop PATH에 docker 있을 때):
#   루트: npm run db:up
#   한 번에 DB+마이그레이션: npm run db:setup
#   또는: powershell -File .\scripts\setup-postgres.ps1
#   URL: postgresql://diary:diary@localhost:5432/diary
#
# Windows 네이티브 PostgreSQL (B, EDB 설치본):
#   1) 설치 마법사 완료 → 데이터 클러스터 + Windows 서비스 등록 (서비스 이름 예: postgresql-x64-18)
#   2) 서비스가 "실행 중"인지 확인 (services.msc). 5432 연결 거부면 여기서 멈춘 경우가 많음.
#   3) psql 예: "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -h localhost -d postgres
#   4) 한 번 실행할 SQL (이름은 예시, 본인 계정/DB명에 맞게):
#        CREATE USER app_user WITH PASSWORD '...';
#        CREATE DATABASE app_db OWNER app_user;
#   5) Prisma가 "public 스키마 권한 없음" 등이면 postgres 로 같은 DB에 접속 후:
#        GRANT CONNECT ON DATABASE app_db TO app_user;
#        GRANT ALL PRIVILEGES ON DATABASE app_db TO app_user;
#        GRANT CREATE, USAGE ON SCHEMA public TO app_user;
#   6) DATABASE_URL=postgresql://app_user:비밀번호@localhost:5432/app_db
#   7) .env 저장 후: cd backend && npm run db:deploy
DATABASE_URL=postgresql://app_user:PASSWORD@localhost:5432/app_db

# OpenAI — 일기 제출 시 선생님 톤 답글 (없으면 답글만 생략)
OPENAI_API_KEY= 

# Firebase Admin (서버) — 서비스 계정 JSON의 필드
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM은 줄바꿈을 \n 으로 이스케이프해서 한 줄로 넣는 경우가 많음
FIREBASE_PRIVATE_KEY=
