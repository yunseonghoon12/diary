# Next.js (프론트)
# 권장: NEXT_PUBLIC_API_URL 은 설정하지 않음 → 브라우저는 /api/backend 로만 요청 (같은 출처).
# 직접 API 도메인에 붙이려면(이때 Render CORS_ORIGIN 에 Vercel URL 필요): NEXT_PUBLIC_API_URL=https://xxx.onrender.com
# Vercel에 NEXT_PUBLIC_API_URL 을 빈 값으로 넣지 마세요(404 원인).
# NEXT_PUBLIC_API_URL=
# Nest 주소가 다르면 (프록시 대상). 로컬: BACKEND_URL=http://127.0.0.1:4000
# Vercel 배포 시: 백엔드 공개 URL (예: https://diary-api.onrender.com) — Vercel 프로젝트 Environment Variables 에도 동일 키로 설정
# BACKEND_URL=

# Firebase Web SDK (클라이언트) — 콘솔에서 복사
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
